<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ======================================================================
         Block-time alerts. This is NOT an alarm-clock-core app, so the
         Play-policy-governed USE_EXACT_ALARM is intentionally avoided in
         favor of SCHEDULE_EXACT_ALARM (user-grantable, revocable, has a
         system settings screen). Runtime degrades gracefully to
         setWindow(±10 min) via canScheduleExactAlarms() — see
         BlockAlarmManager.
         ====================================================================== -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ======================================================================
         OTA de atualizações (a ÚNICA rede que o app usa). Uma única
         requisição HTTPS por dia, no máximo, direto ao GitHub Releases
         (api.github.com/repos/Chrispsz/rotina-check/releases/latest),
         sempre em primeiro plano — nada roda em segundo plano.
         ACCESS_NETWORK_STATE é usada apenas para diferir a verificação
         quando a conexão for medida (dados móveis).
         ====================================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RotinaCheck"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One-tap OTA install: the finished APK (app-private external dir)
             is handed to the platform installer through this provider. The
             ACTION_VIEW path needs NO REQUEST_INSTALL_PACKAGES — the system
             installer owns the unknown-source UX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Thin receiver fired by the exact alarm: shows ONE discreet
             notification and chains the next event. No database, no service,
             no I/O beyond DataStore reads (goAsync) — passive battery model:
             between block times the app holds ZERO resident processes. -->
        <receiver
            android:name=".alarm.BlockAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms today's block alarms after reboot / time / timezone
             changes. BOOT_COMPLETED is a protected broadcast, so
             exported=true is safe — third-party apps cannot spoof it. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
